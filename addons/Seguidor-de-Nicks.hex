; Seguidor de Nicks v1.1 - HexDreams IRC
; Guarda el historial por red y host (identidad orientativa).
; JOIN y NICK requieren los campos host, network, nick y chan.

on LOAD {
  set %sn.db $json($state(sn_db),"")
  if $len(%sn.db) == 0 {
    set %sn.db $map()
  }
  delat %sn.db ""
}

alias sn.agregar {
  ; $1 red, $2 host, $3 nick, $4 sala, $5 aviso
  if $1 == "" { return }
  if $2 == "" { return }
  if $3 == "" { return }
  set -l %clave "$1|$lower($2)"
  set -l %nicks $get(%sn.db,%clave)
  set -l %limpios $map()
  delat %limpios ""
  foreach %anterior %nicks {
    set -l %nombre $trim(%anterior)
    if $re_match(%nombre,"^[^\s,:\x00-\x1f]+$") == true {
      setat %limpios $lower(%nombre) %nombre
    }
  }
  setat %limpios $lower($3) $3
  set -l %historial $values(%limpios)
  if $tojson(%nicks) != $tojson(%historial) {
    setat %sn.db %clave %historial
    state.set sn_db $tojson(%sn.db)
  }
  if $5 == "avisar" {
    set -l %otros ""
    foreach %nombre %historial {
      if $lower(%nombre) != $lower($3) {
        if $len(%otros) > 0 {
          set %otros "%otros, %nombre"
        } else {
          set %otros %nombre
        }
      }
    }
    if $len(%otros) > 0 {
      echo $4 ff5959⚠ SEGUIDOR DE NICKS: $3 comparte host con estos nicks anteriores: $trim(%otros).
    }
  }
}

on JOIN {
  if $own == true { return }
  sn.agregar $network $host $nick $chan avisar
}

on NICK {
  if $own == true { return }
  sn.agregar $network $host $nick * registrar
  sn.agregar $network $host $newnick * registrar
}
