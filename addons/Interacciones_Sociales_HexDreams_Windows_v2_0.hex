; INTERACCIONES SOCIALES DREAMS v2.0 - ADAPTACION HEXDREAMS IRC WINDOWS
; Conserva las frases, colores IRC y emojis del archivo original.
; Compatible con HexDreams IRC 0.13.0. No modifica el programa.
; Permisos: read, send, ui. No requiere raw, http, intercept ni persist.
; Desactiva otras versiones del addon para evitar alias duplicados.
; Los grupos usan WHO: el motor Windows no ofrece members/membernames/nick.
; Una ronda grupal a la vez, limite 60 miembros, hasta 8 nicks por mensaje.
; Maximo conservador: 320 bytes de texto, incluidos colores y emojis.
; /cafe y /cafe hate funcionan tambien en el privado actual.
; Revalida presencia y rangos antes de cada bloque. Pausas de 5/15 segundos.
; /social o /ishelp muestran los comandos. /cancelarsaludos detiene la ronda.

on LOAD {
  set %sw_activo 0
  set %sw_token 0
  set %sw_last $json("{}")
  set %sw_nombres $json("{}")
  set %sw_rangos $json("{}")
  set %hdg_activo 0
  set %hdg_token 0
  set %hdg_indice 0
  set %hdg_total 0
  set %hdg_lineas 0
  set %hdg_canal 
  set %hdg_red 
  set %hdg_frase 
  set %hdg_lista 
  set %hdg_tono 
  set %hdg_modo 
  set %ds_cafe_activo 0
  set %ds_cafe_token 0
  set %ds_social_last_baila 0
  set %ds_social_last_zape 0
  set %ds_social_last_abrazo 0
  set %ds_social_last_piropo 0
  set %ds_social_last_bss 0
  set %ds_social_last_muaks 0
  set %ds_social_last_regalo 0
  set %ds_social_last_servir 0
  set %ds_social_last_clap 0
  set %ds_social_last_bd 0
  set %ds_social_last_bn 0
  set %ds_social_last_bt 0
  set %ds_social_last_bm 0
  set %ds_social_last_chau 0
}

alias baila {
  if ($sw_contexto() != 1) { sw_echo Abri una sala o un privado antes de usar el comando. | return }
  if ($len($1) == 0) {
    sw_echo Uso: /baila Nick
    return
  }
  if ($len($chan) == 0) {
    sw_echo Abre una sala o un privado antes de usar el comando.
    return
  }
  set -l %ds_n $rand(1, 6)
  if (%ds_n == %ds_social_last_baila) {
    inc %ds_n
    if (%ds_n > 6) { set -l %ds_n 1 }
  }
  set %ds_social_last_baila %ds_n
  if (%ds_n == 1) { sw_action "13se acerca a 11$113, le toma de la manito y le susurra: ¿Me concedes este baile? 💃🕺" }
  if (%ds_n == 2) { sw_action "13agarra a 11$113 y lo arrastra a la pista. ¡ChUnTa ChUnTa! ¡Vueltita por aquí, meneíto por allá! 🎶" }
  if (%ds_n == 3) { sw_action "13invita a 11$113 a bailar un lento, lo toma suavemente de la cintura y deja que suene la música. 💞" }
  if (%ds_n == 4) { sw_action "13hace girar a 11$113 en plena pista, se enreda con sus propios pies y termina soltando una carcajada. 😂" }
  if (%ds_n == 5) { sw_action "13le ofrece la mano a 11$113: ¡Vamos, que esta canción es nuestra! 💃" }
  if (%ds_n == 6) { sw_action "13saca a 11$113 a bailar rock, gira de un lado al otro y termina haciendo una reverencia. 🎸" }
}

alias zape {
  if ($sw_contexto() != 1) { sw_echo Abri una sala o un privado antes de usar el comando. | return }
  if ($len($1) == 0) {
    sw_echo Uso: /zape Nick
    return
  }
  if ($len($chan) == 0) {
    sw_echo Abre una sala o un privado antes de usar el comando.
    return
  }
  set -l %ds_n $rand(1, 9)
  if (%ds_n == %ds_social_last_zape) {
    inc %ds_n
    if (%ds_n > 9) { set -l %ds_n 1 }
  }
  set %ds_social_last_zape %ds_n
  if (%ds_n == 1) { sw_action "04se acerca sigilosamente a 11$104 y... ¡ZAAAAAPE! ¡Tremendo coscorrón en la nuca! 👋" }
  if (%ds_n == 2) { sw_action "04le dice a 11$104: ¡Mirá para allá! Y cuando se da vuelta... ¡PLAAAAAS! ¡Zape de regalo! 😂" }
  if (%ds_n == 3) { sw_action "04levanta la mano y le da a 11$104 un zape seco y preciso. ¡TOMA, POR DESPISTADO! 👋" }
  if (%ds_n == 4) { sw_action "04espera a que 11$104 se distraiga y ¡ZAS! Le acomoda las ideas de un coscorrón. 😜" }
  if (%ds_n == 5) { sw_action "04se pone detrás de 11$104 y ¡PLOP! Le cae un zape en la nuca sin previo aviso. 👋" }
  if (%ds_n == 6) { sw_action "04mira fijamente a 11$104, sonríe y le suelta un zape de esos que hacen decir: ¡AY! 😂" }
  if (%ds_n == 7) { sw_action "04amaga una caricia a 11$104... ¡pero era un zape travieso! 👋" }
  if (%ds_n == 8) { sw_action "04le da a 11$104 un coscorrón de campeonato y después pone cara de no haber sido. 😇" }
  if (%ds_n == 9) { sw_action "04le toca el hombro a 11$104, espera que se dé vuelta y... ¡ZAPE! 👋" }
}

alias abrazo {
  if ($sw_contexto() != 1) { sw_echo Abri una sala o un privado antes de usar el comando. | return }
  if ($len($1) == 0) {
    sw_echo Uso: /abrazo Nick
    return
  }
  if ($len($chan) == 0) {
    sw_echo Abre una sala o un privado antes de usar el comando.
    return
  }
  set -l %ds_n $rand(1, 6)
  if (%ds_n == %ds_social_last_abrazo) {
    inc %ds_n
    if (%ds_n > 6) { set -l %ds_n 1 }
  }
  set %ds_social_last_abrazo %ds_n
  if (%ds_n == 1) { sw_action "06rodea a 11$106 con los brazos y le da un abrazo enorme, de esos que arreglan un mal día. 🤗" }
  if (%ds_n == 2) { sw_action "06abraza a 11$106 tan fuerte que casi le saca una sonrisa a presión. 🫂" }
  if (%ds_n == 3) { sw_action "06se acerca a 11$106 y le regala un abrazo largo, cálido y lleno de cariño. 💜" }
  if (%ds_n == 4) { sw_action "06abre los brazos de par en par y atrapa a 11$106 en un abrazo sorpresa. 🤗" }
  if (%ds_n == 5) { sw_action "06le da a 11$106 un abrazo apretadito y le susurra: ¡Qué bueno que estés acá! ✨" }
  if (%ds_n == 6) { sw_action "06se queda un ratito abrazando a 11$106, porque hay afectos que no necesitan palabras. 💕" }
}

alias piropo {
  if ($sw_contexto() != 1) { sw_echo Abri una sala o un privado antes de usar el comando. | return }
  if ($len($1) == 0) {
    sw_echo Uso: /piropo Nick
    return
  }
  if ($len($chan) == 0) {
    sw_echo Abre una sala o un privado antes de usar el comando.
    return
  }
  set -l %ds_n $rand(1, 24)
  if (%ds_n == %ds_social_last_piropo) {
    inc %ds_n
    if (%ds_n > 24) { set -l %ds_n 1 }
  }
  set %ds_social_last_piropo %ds_n
  if (%ds_n == 1) { sw_action "12le dice a 11$112: Si la dulzura pagara impuestos, vos ya deberías una fortuna. 😉" }
  if (%ds_n == 2) { sw_action "12se acerca a 11$112 y confiesa: Sos esa sonrisa que mejora cualquier día. 💫" }
  if (%ds_n == 3) { sw_action "12le guiña un ojo a 11$112: ¿Siempre iluminás tanto o hoy viniste con luces extra? ✨" }
  if (%ds_n == 4) { sw_action "12le dice a 11$112: Tenés algo peligroso... ¡la capacidad de alegrarme el día! 😏" }
  if (%ds_n == 5) { sw_action "12mira a 11$112 y suspira: Con esa sonrisa, ni el café me hace falta. ☕" }
  if (%ds_n == 6) { sw_action "12le dice a 11$112: Si fueras canción, te pondría en repetición. 🎶" }
  if (%ds_n == 7) { sw_action "12se inclina hacia 11$112: ¿Sos casualidad o la mejor coincidencia de este chat? 💜" }
  if (%ds_n == 8) { sw_action "12le comenta a 11$112: A tu lado, hasta el silencio tiene buena compañía. 🌷" }
  if (%ds_n == 9) { sw_action "12le dice a 11$112: Lo tuyo no es encanto, ¡es abuso de carisma! 😜" }
  if (%ds_n == 10) { sw_action "12le confiesa a 11$112: Hay personas especiales... y después estás vos. 💖" }
  if (%ds_n == 11) { sw_action "12le pregunta a 11$112: ¿Tenés un mapa? Porque me pierdo en tu sonrisa. 😉" }
  if (%ds_n == 12) { sw_action "12mira a 11$112 y dice: Qué suerte la del espejo, que te ve todos los días. ✨" }
  if (%ds_n == 13) { sw_action "12le dice a 11$112: No sé de magia, pero vos cambiás el ambiente cuando aparecés. 🌟" }
  if (%ds_n == 14) { sw_action "12sonríe a 11$112: Si la simpatía fuera un deporte, ya tendrías medalla de oro. 🏅" }
  if (%ds_n == 15) { sw_action "12le dice a 11$112: ¿Sabés qué te queda bien? Ser vos. 💜" }
  if (%ds_n == 16) { sw_action "12le susurra a 11$112: Tenés pinta de problema... de esos que uno quiere conocer. 😏" }
  if (%ds_n == 17) { sw_action "12le dice a 11$112: Sos una de esas buenas noticias que llegan sin avisar. 💌" }
  if (%ds_n == 18) { sw_action "12le guiña un ojo a 11$112: ¿Venís seguido por aquí o esperabas que te invitara? 😉" }
  if (%ds_n == 19) { sw_action "12le confiesa a 11$112: Si sonreír fuera delito, ya me habrías condenado. 😍" }
  if (%ds_n == 20) { sw_action "12le dice a 11$112: No sé qué perfume usás, pero dejás el aire lleno de alegría. 🌸" }
  if (%ds_n == 21) { sw_action "12mira a 11$112 y comenta: Hay estrellas en el cielo... pero vos brillás en esta sala. ✨" }
  if (%ds_n == 22) { sw_action "12le dice a 11$112: ¿Te puedo pedir un favor? Seguí siendo así de adorable. 🥰" }
  if (%ds_n == 23) { sw_action "12se acerca a 11$112: Ojo con esa mirada, que me distraés de la conversación. 😜" }
  if (%ds_n == 24) { sw_action "12le dice a 11$112: No prometo la luna, pero sí una buena charla y muchas risas. 🌙" }
}

alias bss {
  if ($sw_contexto() != 1) { sw_echo Abri una sala o un privado antes de usar el comando. | return }
  if ($len($1) == 0) {
    sw_echo Uso: /bss Nick
    return
  }
  if ($len($chan) == 0) {
    sw_echo Abre una sala o un privado antes de usar el comando.
    return
  }
  set -l %ds_n $rand(1, 6)
  if (%ds_n == %ds_social_last_bss) {
    inc %ds_n
    if (%ds_n > 6) { set -l %ds_n 1 }
  }
  set %ds_social_last_bss %ds_n
  if (%ds_n == 1) { sw_action "13le manda a 11$113 un besito enorme con muchísimo cariño. ¡Muaaaaaks! 😘" }
  if (%ds_n == 2) { sw_action "13se acerca a 11$113 y le deja un beso dulce en la mejilla. 💋" }
  if (%ds_n == 3) { sw_action "13le tira a 11$113 una lluvia de besitos voladores. ¡Mua, mua, mua! 😘" }
  if (%ds_n == 4) { sw_action "13le roba a 11$113 un besito travieso y sale corriendo entre risas. 😜" }
  if (%ds_n == 5) { sw_action "13le manda a 11$113 besos de esos que atraviesan cualquier distancia. 💞" }
  if (%ds_n == 6) { sw_action "13le regala a 11$113 un besito con moño, dedicado especialmente. 🎀" }
}


; MUAKS: lluvia multicolor de besos para un nick.
alias muaks {
  if ($sw_contexto() != 1) { sw_echo Abri una sala o un privado antes de usar el comando. | return }
  if ($len($1) == 0) { sw_echo Uso: /muaks Nick | return }
  if ($len($chan) == 0) { sw_echo Abre una sala antes de usar /muaks | return }
  set -l %ds_n $rand(1,5)
  if (%ds_n == %ds_social_last_muaks) { inc %ds_n | if (%ds_n > 5) { set %ds_n 1 } }
  set %ds_social_last_muaks %ds_n
  if (%ds_n == 1) { sw_action "le lanza a $1 una lluvia de 04MUAKS 07MUAKS 03MUAKS 12MUAKS 06MUAKS 13MUAKS 😘💋💕" }
  if (%ds_n == 2) { sw_action "llena a $1 de 13MUAK 04MUAK 09MUAK 06MUAK 03MUAK 10MUAK 💋💋💋" }
  if (%ds_n == 3) { sw_action "envía a $1 un torbellino de besitos: 04MUA 07MUA 12MUA 09MUA 13MUA 06MUA 😘🌈" }
  if (%ds_n == 4) { sw_action "le dedica a $1 mil besos de colores: 06MUAKS 10MUAKS 04MUAKS 03MUAKS 09MUAKS 💕💋" }
  if (%ds_n == 5) { sw_action "bombardea cariñosamente a $1 con 07MUAK 13MUAK 12MUAK 04MUAK 10MUAK 06MUAK 😘💖🌈" }
}

